<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	App Transport Security.

	This has to be a real file: `NSAppTransportSecurity` is a dictionary, and
	Xcode's `INFOPLIST_KEY_*` build settings can only set top-level scalars. The
	project carried `INFOPLIST_KEY_NSAppTransportSecurity_NSAllowsArbitraryLoads`
	for several releases and it produced no key at all — the shipped Info.plist
	had no ATS section, so the policy was whatever the default happened to be and
	the "Allow local HTTP" setting could not work on a device.

	A user-configured server may deliberately be a public IP and HTTP port.
	`NSAllowsArbitraryLoads` makes that explicit compatibility mode technically
	possible; `ProfileDraft` still rejects HTTP until the person enables "Allow
	insecure HTTP" for that profile. TLS certificate validation is never disabled.
	-->
	<!--
	The languages this app claims. iOS reads this to decide what to offer in
	Settings > Tessalytics > Language, which is the other place someone might go
	looking, and to pick a localization when the app is launched fresh.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>fr</string>
		<string>ja</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
